{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs",
      "queryLines": [
        "select\n",
        "  sum(total_events)                                   as total_events,\n",
        "  count(distinct repo_id)                             as active_repos,\n",
        "  sum(stars)                                          as stars,\n",
        "  sum(pull_requests_merged)                           as prs_merged,\n",
        "  sum(releases)                                       as releases,\n",
        "  round(100 * sum(bot_events) / sum(total_events), 1) as bot_share_pct\n",
        "from fct_repo_daily_activity"
      ]
    },
    {
      "name": "ds_trending",
      "displayName": "Trending repos",
      "queryLines": [
        "select\n",
        "  concat(lpad(cast(trending_rank as string), 2, '0'), '. ', repo_name) as repo,\n",
        "  trending_rank,\n",
        "  repo_name,\n",
        "  stars_in_window,\n",
        "  stars_prior_window,\n",
        "  star_growth_pct,\n",
        "  forks_in_window,\n",
        "  coalesce(language, 'Not enriched yet') as language\n",
        "from rpt_trending_repos\n",
        "where trending_rank <= 20"
      ]
    },
    {
      "name": "ds_languages",
      "displayName": "Trending languages",
      "queryLines": [
        "select\n",
        "  concat(lpad(cast(language_rank as string), 2, '0'), '. ', language) as language_label,\n",
        "  language,\n",
        "  stars_in_window,\n",
        "  repos_with_stars,\n",
        "  stars_share_pct,\n",
        "  trending_repos,\n",
        "  top_repo\n",
        "from rpt_trending_languages\n",
        "where language_rank <= 12"
      ]
    },
    {
      "name": "ds_breakout",
      "displayName": "Breakout new repos",
      "queryLines": [
        "select\n",
        "  repo_name,\n",
        "  coalesce(language, '-') as language,\n",
        "  stars_in_window,\n",
        "  total_stars,\n",
        "  datediff(as_of_date, to_date(repo_created_at)) as age_days,\n",
        "  description\n",
        "from rpt_trending_repos\n",
        "where is_new_repo\n",
        "order by stars_in_window desc, total_stars desc\n",
        "limit 15"
      ]
    },
    {
      "name": "ds_hourly",
      "displayName": "Activity by hour (human vs bot)",
      "queryLines": [
        "select lpad(cast(event_hour as string), 2, '0') as hour_utc, 'Human' as actor,\n",
        "       sum(events - bot_events) as events\n",
        "from fct_hourly_activity group by event_hour\n",
        "union all\n",
        "select lpad(cast(event_hour as string), 2, '0') as hour_utc, 'Bot' as actor,\n",
        "       sum(bot_events) as events\n",
        "from fct_hourly_activity group by event_hour"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Activity by day (human vs bot)",
      "queryLines": [
        "select event_date, 'Human' as actor, sum(events - bot_events) as events\n",
        "from fct_hourly_activity group by event_date\n",
        "union all\n",
        "select event_date, 'Bot' as actor, sum(bot_events) as events\n",
        "from fct_hourly_activity group by event_date"
      ]
    },
    {
      "name": "ds_prs",
      "displayName": "Pull requests per day",
      "queryLines": [
        "select event_date, 'Opened' as status, sum(pull_requests_opened) as pull_requests\n",
        "from fct_repo_daily_activity group by event_date\n",
        "union all\n",
        "select event_date, 'Merged' as status, sum(pull_requests_merged) as pull_requests\n",
        "from fct_repo_daily_activity group by event_date"
      ]
    },
    {
      "name": "ds_automation",
      "displayName": "Repos merging the most PRs",
      "queryLines": [
        "select\n",
        "  repo_name,\n",
        "  sum(pull_requests_merged)                           as prs_merged,\n",
        "  sum(pull_requests_opened)                           as prs_opened,\n",
        "  round(100 * sum(bot_events) / sum(total_events), 0) as bot_pct,\n",
        "  max(unique_human_actors)                            as peak_daily_humans\n",
        "from fct_repo_daily_activity\n",
        "group by repo_name\n",
        "order by prs_merged desc\n",
        "limit 25"
      ]
    }
  ],
